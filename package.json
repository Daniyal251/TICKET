{
  "name": "ticket-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Музыкальная экосистема: сайт лейбла + сервис дистрибуции",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
